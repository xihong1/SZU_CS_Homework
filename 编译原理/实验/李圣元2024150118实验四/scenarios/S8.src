// S8: 语义错误示范（词法、语法均合法，但含语义错误）
// 说明：以下代码词法分析和语法分析均可通过，但语义分析将检测到多种错误

// 1) UNDECLARED: 使用未声明的变量
fn(void) testUndeclared ->:
    int a
    a@int = y@int

// 2) REDECLARED: 同一作用域内重复声明
fn(void) testRedeclared ->:
    int x
    int x
    x@int = 1

// 3) TYPE_MISMATCH: 赋值类型不匹配
fn(void) testTypeMismatch ->:
    int a
    string s
    a@int = s@string

// 4) RETURN_TYPE_MISMATCH: 返回值类型与函数声明不匹配
fn(int) testReturnMismatch ->:
    string s
    s@string = "hello"
    return s@string

// 5) ARG_COUNT_MISMATCH: 函数调用参数个数错误
fn(int) add -> a@int, b@int:
    return a@int + b@int

fn(void) testArgCount ->:
    int x
    x@int = add->(1)

// 6) ARG_TYPE_MISMATCH: 函数调用参数类型错误
fn(void) testArgType ->:
    int x
    string s
    s@string = "world"
    x@int = add->(s@string, 2)

// 7) NOT_A_FUNCTION: 将非函数当作函数调用
fn(void) testNotFunc ->:
    int x
    x@int = 5
    print->(x->(1, 2))

// 8) 运算符类型错误
fn(void) testOpType ->:
    int a
    bool b
    a@int = 1
    b@bool = true
    print->(a@int + b@bool)

fn(void) main ->:
    testUndeclared->()
    testRedeclared->()
    testTypeMismatch->()
    testReturnMismatch->()
    testArgCount->()
    testArgType->()
    testNotFunc->()
    testOpType->()
