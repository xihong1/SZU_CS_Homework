      <Param name="conditions" updates="None" val="[{'prompt_word': '红', 'prompt_color': 'red', 'left_color': 'red', 'right_color': 'green', 'cor_pass': 'left'}, {'prompt_word': '红', 'prompt_color': 'blue', 'left_color': 'green', 'right_color': 'blue', 'cor_pass': 'right'}, {'prompt_word': '红', 'prompt_color': 'green', 'left_color': 'red', 'right_color': 'green', 'cor_pass': 'right'}, {'prompt_word': '绿', 'prompt_color': 'red', 'left_color': 'red', 'right_color': 'blue', 'cor_pass': 'left'}, {'prompt_word': '绿', 'prompt_color': 'blue', 'left_color': 'blue', 'right_color': 'green', 'cor_pass': 'left'}, {'prompt_word': '绿', 'prompt_color': 'green', 'left_color': 'green', 'right_color': 'blue', 'cor_pass': 'left'}, {'prompt_word': '蓝', 'prompt_color': 'red', 'left_color': 'red', 'right_color': 'green', 'cor_pass': 'left'}, {'prompt_word': '蓝', 'prompt_color': 'blue', 'left_color': 'green', 'right_color': 'blue', 'cor_pass': 'right'}, {'prompt_word': '蓝', 'prompt_color': 'green', 'left_color': 'red', 'right_color': 'green', 'cor_pass': 'right'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="image/chose_color.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="3" valType="code"/>
      <Param name="name" updates="None" val="loop2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial2"/>
    <Routine name="feedback_tesst2"/>
    <LoopTerminator name="loop2"/>
    <Routine name="endtest"/>
  </Flow>
