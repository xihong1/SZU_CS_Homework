  <Flow>
    <Routine name="welcome"/>
    <Routine name="text_test1"/>
    <LoopInitiator loopType="TrialHandler" name="loop1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'cat_path': 'image\\cat\\cat.png', 'dog_path': 'image\\dog\\dog.png'}, {'cat_path': 'image\\cat\\cat2.png', 'dog_path': 'image\\dog\\dog2.png'}, {'cat_path': 'image\\cat\\cat3.png', 'dog_path': 'image\\dog\\dog3.png'}]" valType="str"/>
